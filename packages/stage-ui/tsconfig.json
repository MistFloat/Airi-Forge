{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "DOM",
      "DOM.AsyncIterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": [
      "vitest",
      "vite/client",
      "unplugin-info/client",
      "@types/audioworklet",
      "@webgpu/types"
    ],
    // NOTICE: workspace packages export raw TS source (e.g. @proj-airi/memory-pgvector)
    // whose internal relative imports keep explicit .ts extensions because Node ESM
    // (type stripping) loads them directly at runtime (see nodeEsmImport.test.ts).
    // This project typechecks that source, so it must opt into .ts specifiers.
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "plugins": [
      "@vue-macros/volar/define-models",
      "@vue-macros/volar/define-slots"
    ],
    "skipTemplateCodegen": false
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/**/*.story.vue",
    "stories/**/*.ts",
    "stories/**/*.d.ts",
    "stories/**/*.vue",
    "stories/**/*.story.vue"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
